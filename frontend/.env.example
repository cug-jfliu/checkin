# 环境变量示例文件（可提交到 Git）
#
# 前端根据运行模式自动加载对应的 .env 文件：
#   开发环境（vite dev）  → .env.development   VITE_API_BASE_URL=http://localhost:3000/api
#   生产环境（vite build）→ .env.production     VITE_API_BASE_URL=/api
#
# 使用方法：
#   cp .env.example .env.development   # 本地开发
#   cp .env.example .env.production    # 按需修改生产地址

VITE_API_BASE_URL=http://localhost:3000/api

# Typst 编译器 WASM 下载地址（可选）
# - 方案B（Worker 托管前端）若构建产物里 wasm 超过 25MiB，必须改成运行时从外部拉取
# - 建议放到 Cloudflare R2/Pages/CDN，然后这里填那个 URL
# VITE_TYPST_COMPILER_WASM_URL=https://example.com/typst_ts_web_compiler_bg.wasm
